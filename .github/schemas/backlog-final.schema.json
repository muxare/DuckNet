{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "DuckNet backlog build — merged result",
  "description": "What merge-confidence.sh produces. Checks the join landed: every item carries a state and a confidence slot, null when the assessment pass did not cover it.",
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "sources": { "type": "array" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["epic", "story"] },
          "title": { "type": "string" },
          "state": { "type": ["string", "null"], "enum": ["new", "partially-implemented", "already-done", "unfounded", null] },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "confidence_rationale": { "type": ["string", "null"] }
        },
        "required": ["id", "kind", "title", "confidence", "confidence_rationale"]
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "items", "notes"]
}
