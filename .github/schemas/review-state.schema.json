{
  "type": "object",
  "properties": {
    "pullRequest": {
      "type": "object",
      "properties": {
        "number": { "type": "integer" },
        "title": { "type": "string" },
        "sha": { "type": "string" }
      },
      "required": ["number", "title", "sha"],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["level", "reasons"],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["architecture", "security", "other"]
            }
          }
        },
        "required": ["path", "risk", "areas"],
        "additionalProperties": false
      }
    },
    "requestedReviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["architecture", "security"]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer": {
            "type": "string",
            "enum": ["architecture", "security"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "file": { "type": "string" },
          "detail": { "type": "string" },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rule": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": ["reviewer", "severity", "detail"],
        "additionalProperties": false
      }
    },
    "skipped": { "type": "boolean" }
  },
  "required": [
    "pullRequest",
    "risk",
    "files",
    "requestedReviewers",
    "findings",
    "skipped"
  ],
  "additionalProperties": false
}
